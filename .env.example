# Every key here is read by src/config.ts's loadConfig(). All are optional;
# the value shown after "default" is what applies when the key is unset or
# empty. Copy this file to .env and edit only what you need to change.

# HTTP port the service listens on.
PORT=3000

# Redis connection string. The service is stateless; this is the only state
# it depends on (cache + single-flight locks).
REDIS_URL=redis://127.0.0.1:6379

# Number of browser contexts kept warm in the pool. A third concurrent
# request against POOL_SIZE=2 queues rather than failing.
POOL_SIZE=2

# How many extractions a context serves before it is recycled (bounds
# per-context memory growth from a long-lived Chromium page).
CONTEXT_MAX_USES=50

# Upper bound, in milliseconds, on a single page navigation.
NAV_TIMEOUT_MS=45000

# Upper bound, in milliseconds, on one whole produce() call: navigation, the
# scroll loop that pages through a large playlist, and a settle pause. This
# same value also sets the cache's single-flight lock TTL (see cache.ts) --
# raising it without understanding that coupling can let a lock outlive its
# holder, or expire while the holder is still working. Default matches
# src/config.ts's DEFAULT_PRODUCE_BUDGET_MS.
PRODUCE_BUDGET_MS=150000

# Cache TTLs, in seconds, per entity kind.
# A track's artist and title never change once released.
TTL_TRACK=2592000
# An album's listing is fixed at release.
TTL_ALBUM=2592000
# Playlists genuinely change, so they get hours, not days.
TTL_PLAYLIST=14400
# How long a confirmed-absent id is negative-cached before being retried.
TTL_NEGATIVE=600

# How long a failed extraction stays visible to the callers already waiting
# on that same id, so they learn the outcome instead of each starting their
# own redundant extraction. Seconds, deliberately: this is a handoff to the
# cohort already blocked, NOT a negative cache for errors. Raising it does
# throttle a permanently-broken entity -- at the price of caching our own
# bugs, so a scraper you have already fixed and redeployed keeps serving the
# old failure for this long.
FAILURE_RELAY_TTL=5

# --- docker-compose only, not read by loadConfig ---
#
# This host's own VLAN 30 address, e.g. 192.168.30.30. Required -- compose
# refuses to start without it (see docker-compose.yml). Per
# docs/bot-ingress-contract.md requirement 2, a service publishes on its own
# VLAN 30 address, never 0.0.0.0; 192.168.30.0 is the network address itself
# and cannot be bound on any host, so there is no usable default here.
BIND_ADDR=
